# Secret key
SECRET_KEY="CHANGE-ME"

# 0 False, 1 True
DEBUG="True"

# Comma Separated Values
ALLOWED_HOSTS="localhost,127.0.0.1"

# Database configs
# DATABASE_URL has priority. POSTGRES_URL is accepted as a fallback.
DATABASE_URL="postgres://CHANGE-ME:CHANGE-ME@localhost:5432/CHANGE-ME"
POSTGRES_URL="postgres://CHANGE-ME:CHANGE-ME@localhost:5432/CHANGE-ME"

# Used by docker-compose.yaml to build the backend DATABASE_URL.
POSTGRES_DB="auction_system_db"
POSTGRES_USER="CHANGE-ME"
POSTGRES_PASSWORD="CHANGE-ME"
POSTGRES_PORT="5432"

# Comma Separated Values
CORS_ALLOWED_ORIGINS="http://localhost:5173"
