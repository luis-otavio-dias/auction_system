# Secret key
SECRET_KEY="replace-with-a-long-random-production-secret"

# 0 False, 1 True
DEBUG="True"

# Comma Separated Values
ALLOWED_HOSTS="localhost,127.0.0.1"

# Database configs
# DATABASE_URL has priority. POSTGRES_URL is accepted as a fallback.
DATABASE_URL="postgres://auction_user:change-me@localhost:5432/auction_system_db"
POSTGRES_URL=""

# Used by docker-compose.yaml to build the backend DATABASE_URL.
POSTGRES_DB="auction_system_db"
POSTGRES_USER="auction_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_PORT="5432"

# Comma Separated Values
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# JWT cookies. Set AUTH_COOKIE_SECURE=True in production/HTTPS.
AUTH_COOKIE_SECURE="False"
AUTH_COOKIE_SAMESITE="Lax"
AUTH_COOKIE_DOMAIN=""

# WebSocket origins. Falls back to CORS_ALLOWED_ORIGINS when empty.
WS_ALLOWED_ORIGINS="http://localhost:5173"

# HMAC secrets for bid history and receipts. Set independent random values.
BID_HISTORY_SECRET="replace-with-an-independent-history-hmac-secret"
RECEIPT_SECRET="replace-with-a-different-receipt-hmac-secret"

# External audit checkpoint file (outside the database).
BID_ANCHOR_PATH=""

# Public catalog provider.
CATALOG_PROVIDER="artic"
CATALOG_HTTP_TIMEOUT_SECONDS="5"
CATALOG_HTTP_MAX_ATTEMPTS="2"
CATALOG_HTTP_BACKOFF_SECONDS="0.2"
CATALOG_CIRCUIT_THRESHOLD="3"
CATALOG_CIRCUIT_COOLDOWN_SECONDS="60"
CATALOG_SEARCH_CACHE_SECONDS="300"
CATALOG_USER_AGENT="AuctionSystem/0.1 (Art Institute of Chicago catalog integration)"

# Frontend URL used in shared receipt links.
FRONTEND_URL="http://localhost:5173"

# Settlement ticker (single web process).
ENABLE_SETTLEMENT_TICKER="True"
SETTLEMENT_INTERVAL_SECONDS="5"
SETTLEMENT_BATCH_SIZE="50"

# WebSocket ticket/connection lifetime in seconds.
WS_TICKET_MAX_AGE_SECONDS="60"
WS_CONNECTION_MAX_AGE_SECONDS="900"
