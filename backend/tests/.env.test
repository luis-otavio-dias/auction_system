# Fallback environment for the test suite (loaded by pytest-dotenv).
#
# Precedence: real environment variables > backend/.env > this file.
# Lets `pytest` run without a local .env (e.g. in CI) while keeping the
# production-mode guards in core/settings.py active (DEBUG=False).
# These are throwaway, test-only values — never use them anywhere else.
#
# DATABASE_URL is intentionally not set here: it must point to a real
# PostgreSQL instance and is provided by backend/.env or the CI workflow.

DEBUG="False"
SECRET_KEY="test-only-secret-key-not-for-production-0123456789abcdefghij"
BID_HISTORY_SECRET="test-only-bid-history-hmac-secret-0123456789abcdefghij"
RECEIPT_SECRET="test-only-receipt-hmac-secret-0123456789abcdefghijklmnop"
ALLOWED_HOSTS="localhost,127.0.0.1,testserver"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
WS_ALLOWED_ORIGINS="http://localhost:5173"
